{
  "backend": {
    "type": "llama_cpp",

    "llama_cpp": {
      "model_path":      "models/Qwen_Qwen3.5-4B-Q4_K_M.gguf",
      "chat_template":   "qwen3",
      "context_length":  8192,
      "gpu_layers":      24,
      "threads":         8
    },

    "tensorrt": {
      "engine_path":         "models/qwen-1.2b-engine",
      "tokenizer_path":      "models/qwen-1.2b-tokenizer",
      "chat_template":       "qwen3",
      "max_batch_size":      1,
      "max_seq_len":         8192,
      "kv_cache_fraction":   0.5,
      "use_int8":            true
    }
  },

  "inference": {
    "temperature":          0.7,
    "top_p":                0.9,
    "max_tokens_feeling":   256,
    "max_tokens_response":  1024
  },

  "feeling_schema": {
    "type":         "structured_json",
    "grammar_path": "src/prompts/feeling_schema.gbnf",
    "fields": {
      "confidence":            "float (0-1)",
      "reasoning_type":        "string (analogical|causal|deductive|inductive|abductive|associative)",
      "uncertainty_flag":      "boolean",
      "rule_candidate_signal": "boolean",
      "contradiction_flag":    "boolean",
      "reasoning_domain":      "string (factual|ethical|spatial|temporal|social|mathematical)"
    },
    "max_tokens": 256
  },

  "memory": {
    "rule_store_path":       "data/memory/rules.json",
    "knowledge_graph_path":  "data/memory/knowledge.json",
    "episodic_log_path":     "logs/episodic.log",
    "max_rules":             1000
  },

  "verifier": {
    "mode":                    "symbolic",
    "neural_model_path":       "",
    "neural_gpu_layers":       0,
    "neural_max_tokens":       512,
    "contradiction_threshold": 0.75,
    "rule_confidence_decay":   0.01,
    "min_rule_confidence":     0.3
  },

  "feedback": {
    "max_retries":            3,
    "retry_delay_ms":         100,
    "rule_injection_format":  "prepend_to_context"
  },

  "retriever": {
    "mode":                          "hybrid",
    "keyword_weight":                0.7,
    "semantic_weight":               0.3,
    "max_results":                   5,
    "min_score":                     0.1,
    "cache_rebuild_strategy":        "on_demand",
    "cache_rebuild_threshold":       10,
    "cache_rebuild_interval_seconds": 300
  },

  "api": {
    "http_enabled":            true,
    "host":                    "127.0.0.1",
    "port":                    8080,
    "auth_enabled":            true,
    "api_key":                 "secret_api_key",
    "stream_enabled":          true,
    "max_request_size_kb":     1024,
    "request_timeout_seconds": 120
  },

  "tools": {
    "browser_enabled":     true,
    "max_browse_depth":    3,
    "search_results_limit": 5
  },

  "benchmark": {
    "dataset":                  "data/babi_tasks.json",
    "metrics":                  [ "consistency", "parseability", "accuracy" ],
    "eval_frequency_seconds":   3600
  },

  "logging": {
    "level": "info",
    "path":  "logs/cardinal.log"
  }
}
