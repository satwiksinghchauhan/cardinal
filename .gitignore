# =============================================================================
# Cardinal .gitignore
# =============================================================================

# Build directories (CMake output)
build/
out/
cmake-build-*/
.vs/CMakeSettings.json

# Visual Studio specific
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# Compiled binaries
*.exe
*.exe.manifest
*.dll
*.so
*.dylib
*.lib
*.exp
*.obj
*.o
*.a
*.pdb
*.ilk
*.idb
*.ipdb
*.iobj
*.ipch

# CMake generated
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
*.cmake
!CMakeLists.txt
!*.cmake.in
Makefile
CPackConfig.cmake
CPackSourceConfig.cmake

# Python (for gguf tools if used)
__pycache__/
*.py[cod]
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
.eggs/
*.egg-info/
*.egg

# =============================================================================
# Runtime data (user-specific, don't commit)
# =============================================================================

# SQLite databases
*.db
*.db-journal
*.db-wal
*.db-shm

# Logs
logs/*.log
*.log

# Training data (generated)
data/training_export.jsonl
data/*.jsonl

# Episodic data (user conversations)
data/memory/*.json
!data/memory/*.template.json

# Model files (too large, user provides)
models/*.gguf
models/*.bin
models/*.ggml
models/vision/*.gguf
models/vision/*.bin
models/vision/*.ggml

# =============================================================================
# IDE and Editor files
# =============================================================================

# Visual Studio Code
.vscode/
*.code-workspace

# CLion
.idea/
*.iml

# Qt Creator
*.user
*.creator
*.files
*.includes
*.config

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# =============================================================================
# Archive and temp files
# =============================================================================

# Archives (user created)
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*_backup

# =============================================================================
# OS generated files
# =============================================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# Linux
.directory
*.swp
.DS_Store
.ds_store
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

## =============================================================================
# Vendor dependencies (track source, ignore build artifacts)
# =============================================================================

# Track the vendor folder itself (so it exists on clone)
!vendor/
vendor/*/

# But ignore build artifacts inside vendor
vendor/*/build/
vendor/*/cmake-build-*/
vendor/*/out/
vendor/*/.vs/

# Ignore compiled binaries in vendor
vendor/*/*.o
vendor/*/*.a
vendor/*/*.so
vendor/*/*.dll
vendor/*/*.exe

# Ignore CMake cache files in vendor subdirs
vendor/*/CMakeCache.txt
vendor/*/CMakeFiles/

# Specific: ignore llama.cpp build folder entirely
vendor/llama.cpp/build/
vendor/llama.cpp/out/

# Keep the .gitkeep so the folder exists even if empty
!vendor/.gitkeep

# =============================================================================
# Documentation build
# =============================================================================

docs/_build/
docs/api/_build/

# =============================================================================
# Testing
# =============================================================================

*.gcda
*.gcno
*.gcov
coverage/
htmlcov/
.tox/
*.coverage
*.coverage.*

# =============================================================================
# Docker
# =============================================================================

.docker/
docker-compose.override.yml

# =============================================================================
# Environment and secrets
# =============================================================================

.env
.env.local
.env.*.local
*.pem
*.key
*.crt

# =============================================================================
# Package managers
# =============================================================================

# npm (if any web tools)
node_modules/
package-lock.json

# pip
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
*.egg

# =============================================================================
# Profiling
# =============================================================================

*.prof
*.gcda
*.gcno
callgrind.out.*
.vs
